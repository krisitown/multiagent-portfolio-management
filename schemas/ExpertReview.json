              "type": "null"
            }
          ],
          "default": null,
          "title": "Deliverable"
        },
        "expiry": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "instrument_type": {
          "minLength": 1,
          "title": "Instrument Type",
          "type": "string"
        },
        "multiplier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
