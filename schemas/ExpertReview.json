            "minLength": 1,
            "type": "string"
          },
          "title": "Calculation Refs",
          "type": "array"
        },
        "contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
