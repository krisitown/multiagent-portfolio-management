{
  "$defs": {
    "Availability": {
      "enum": [
        "known",
        "unknown",
        "unavailable",
        "not_applicable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "ContractIdentity": {
      "additionalProperties": false,
      "properties": {
        "adjustment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjustment"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "deliverable": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deliverable"
        },
        "expiry": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "instrument_type": {
          "minLength": 1,
          "title": "Instrument Type",
          "type": "string"
        },
        "multiplier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Multiplier"
        },
        "option_right": {
          "anyOf": [
            {
              "enum": [
                "put",
                "call"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Option Right"
        },
        "provider_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Provider Ids",
          "type": "object"
        },
        "raw": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Raw",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "strike": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strike"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "underlying_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underlying Id"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        }
      },
      "required": [
        "instrument_id",
        "instrument_type",
        "currency"
      ],
      "title": "ContractIdentity",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "affected_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "reason"
      ],
      "title": "Finding",
      "type": "object"
    },
    "JsonValue": {},
    "QuantityValue": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "availability",
        "unit"
      ],
      "title": "QuantityValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "contract": {
      "$ref": "#/$defs/ContractIdentity"
    },
    "cost_basis": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuantityValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "encumbered_quantity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Encumbered Quantity"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "position_id": {
      "minLength": 1,
      "title": "Position Id",
      "type": "string"
    },
    "quantity": {
      "title": "Quantity",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "valuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuantityValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "position_id",
    "contract",
    "quantity",
    "currency"
  ],
  "title": "Position",
  "type": "object"
}
