{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "affected_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "reason"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ResearchJob": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "job_id": {
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "question"
      ],
      "title": "ResearchJob",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment": {
      "title": "Assessment",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "requested_follow_up": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResearchJob"
      },
      "title": "Requested Follow Up",
      "type": "array"
    },
    "shortlist_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Shortlist Refs",
      "type": "array"
    }
  },
  "required": [
    "assessment"
  ],
  "title": "ExpertResult",
  "type": "object"
}
