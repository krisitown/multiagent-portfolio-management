# Generic operator configuration. Supply your own model endpoint and key.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=qwen
MODEL_API_KEY=local-server-placeholder
MODEL_REASONING_EFFORT=medium
MODEL_MAX_OUTPUT_TOKENS=16384
RUN_DEADLINE_SECONDS=7200
RUN_OUTPUT_DIR=./runs
PORTFOLIO_PATH=./examples/portfolio-fictional.txt
# Optional; no continuity files are shipped.
CONTINUITY_DIR=
# Optional matching local tokenizer for exact checker context counting.
MODEL_TOKENIZER_PATH=
# Optional existing Hermes public-web connector. All paths are operator supplied.
RESEARCH_PYTHON=
RESEARCH_CWD=
RESEARCH_ENV_FILE=
